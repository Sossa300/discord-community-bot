# Copy this file to .env and fill in your values.
# NEVER commit .env - the token gives full control over your bot.

# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_BOT_TOKEN=your-token-from-the-developer-portal

# Optional: ID of your test server. Slash commands then show up there
# instantly. Leave empty to register them on every server (global).
# (Discord: User Settings -> Advanced -> Developer Mode, then right-click
# the server icon -> Copy Server ID)
GUILD_ID=

# SQLite database file
DB_PATH=data/community.db

# How often due reminders and finished polls are checked (seconds, min. 5)
CHECK_INTERVAL_SECONDS=30

# Max. open reminders per member and server
MAX_REMINDERS_PER_USER=10

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
